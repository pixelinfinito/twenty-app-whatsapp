--- /dev/null
+++ b/packages/twenty-server/src/engine/guards/utils/is-tool-caller-read-request.util.ts
@@ -0,0 +1,21 @@
+import { type Request } from 'express';
+import { getOperationAST, parse } from 'graphql';
+
+export const isToolCallerReadRequest = (request: Request): boolean => {
+  const path = request.originalUrl?.split('?')[0];
+  if (path?.startsWith('/rest/') && request.method === 'GET') return true;
+  if (
+    path !== '/graphql' ||
+    request.method !== 'POST' ||
+    typeof request.body?.query !== 'string'
+  )
+    return false;
+  try {
+    return (
+      getOperationAST(parse(request.body.query), request.body.operationName)
+        ?.operation === 'query'
+    );
+  } catch {
+    return false;
+  }
+};
