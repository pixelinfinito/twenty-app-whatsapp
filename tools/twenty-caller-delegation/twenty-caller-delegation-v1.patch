+++ b/packages/twenty-server/src/engine/core-modules/tool-provider/services/__tests__/logic-function-tool-delegation.service.spec.ts
@@ -0,0 +1,187 @@
+import { LogicFunctionToolDelegationService } from '../logic-function-tool-delegation.service';
+import { type ToolProviderContext } from '../../interfaces/tool-provider-context.type';
+import { type WorkspaceCacheService } from 'src/engine/workspace-cache/services/workspace-cache.service';
+import { type ApplicationTokenService } from 'src/engine/core-modules/auth/token/services/application-token.service';
+import { type JwtWrapperService } from 'src/engine/core-modules/jwt/services/jwt-wrapper.service';
+
+describe('logic function caller delegation', () => {
+  const operator = '1cba9552-106e-48e1-bc1e-6ebc4ecc1747';
+  const admin = '226d7710-f5c4-4d52-a1ea-3b164c18ba73';
+  const role = (id: string, flags: string[], all = false) => ({
+    id,
+    canAccessAllTools: all,
+    rolePermissionFlagIds: flags,
+  });
+  const context = (
+    kind: 'user' | 'apiKey' | 'agent' = 'user',
+  ): ToolProviderContext =>
+    ({
+      workspaceId: 'workspace',
+      userId: kind === 'user' ? 'user' : undefined,
+      userWorkspaceId: kind === 'user' ? 'membership' : undefined,
+      agentId: kind === 'agent' ? 'agent' : undefined,
+      application: kind === 'agent' ? { id: 'origin-app' } : undefined,
+      authContext:
+        kind === 'user'
+          ? { type: 'user', workspaceMemberId: 'member' }
+          : kind === 'apiKey'
+            ? { type: 'apiKey', apiKey: { id: 'key' } }
+            : undefined,
+      rolePermissionConfig: {
+        intersectionOf: { userWorkspaceRoleId: 'operator-role' },
+      },
+    }) as unknown as ToolProviderContext;
+  const cache = { getOrRecompute: jest.fn() };
+  const applicationTokens = {
+    generateApplicationAccessToken: jest
+      .fn()
+      .mockResolvedValue({ token: 'delegated-app-token' }),
+  };
+  const jwt = {
+    signAsyncOrThrow: jest.fn().mockResolvedValue('delegated-key-token'),
+  };
+  const service = new LogicFunctionToolDelegationService(
+    cache as unknown as WorkspaceCacheService,
+    applicationTokens as unknown as ApplicationTokenService,
+    jwt as unknown as JwtWrapperService,
+  );
+  beforeEach(() => {
+    jest.clearAllMocks();
+    cache.getOrRecompute.mockResolvedValue({
+      flatAgentMaps: {
+        universalIdentifierById: { agent: 'agent' },
+        byUniversalIdentifier: {
+          agent: { id: 'agent', applicationId: 'origin-app', deletedAt: null },
+        },
+      },
+      flatRoleMaps: {
+        universalIdentifierById: {
+          'operator-role': 'operator-role',
+          'admin-role': 'admin-role',
+        },
+        byUniversalIdentifier: {
+          'operator-role': role('operator-role', ['operator-grant']),
+          'admin-role': role('admin-role', ['operator-grant', 'admin-grant']),
+        },
+      },
+      flatRolePermissionFlagMaps: {
+        universalIdentifierById: {
+          'operator-grant': 'operator-grant',
+          'admin-grant': 'admin-grant',
+        },
+        byUniversalIdentifier: {
+          'operator-grant': { permissionFlagUniversalIdentifier: operator },
+          'admin-grant': { permissionFlagUniversalIdentifier: admin },
+        },
+      },
+      flatPermissionFlagMaps: {
+        byUniversalIdentifier: {
+          [operator]: { universalIdentifier: operator, permissionType: 'tool' },
+          [admin]: { universalIdentifier: admin, permissionType: 'tool' },
+        },
+      },
+    });
+  });
+  it('intersects every effective role without promoting the least privileged one', async () => {
+    const ctx = context();
+    ctx.rolePermissionConfig = {
+      intersectionOf: {
+        apiKeyRoleId: 'operator-role',
+        applicationRoleId: 'admin-role',
+      },
+    };
+    expect(await service.permissionFlags(ctx)).toEqual([operator]);
+    expect(
+      await service.allowed(
+        {
+          requiredPermissionFlagUniversalIdentifiers: [admin],
+          callerDelegationVersion: 1,
+        },
+        ctx,
+      ),
+    ).toBe(false);
+  });
+  it.each(['user', 'apiKey', 'agent'] as const)(
+    'delegates %s using its original identity',
+    async (kind) => {
+      const result = await service.delegate(context(kind), 'target-app');
+      expect(result.caller.kind).toBe(kind === 'user' ? 'member' : kind);
+      expect(result.caller.workspaceId).toBe('workspace');
+      if (kind === 'apiKey')
+        expect(jwt.signAsyncOrThrow).toHaveBeenCalledWith(
+          expect.objectContaining({ jti: 'key', type: 'API_KEY' }),
+          { expiresIn: '5m' },
+        );
+      if (kind === 'agent')
+        expect(
+          applicationTokens.generateApplicationAccessToken,
+        ).toHaveBeenCalledWith(
+          expect.objectContaining({
+            applicationId: 'origin-app',
+            agentId: 'agent',
+          }),
+        );
+      if (kind === 'user')
+        expect(result.caller.workspaceMemberId).toBe('member');
+    },
+  );
+  it('retains the agent constraint and provenance on member-backed runs', async () => {
+    const ctx = context('user');
+    ctx.agentId = 'agent';
+    const result = await service.delegate(ctx, 'target-app');
+    expect(result.caller).toMatchObject({
+      kind: 'member',
+      id: 'member',
+      agentId: 'agent',
+      surface: 'AI_TOOL',
+    });
+    expect(
+      applicationTokens.generateApplicationAccessToken,
+    ).toHaveBeenCalledWith(
+      expect.objectContaining({
+        userId: 'user',
+        userWorkspaceId: 'membership',
+        agentId: 'agent',
+        toolCallerDelegation: true,
+      }),
+    );
+  });
+  it('denies missing roles and system bypasses instead of creating an administrator', async () => {
+    const ctx = context();
+    ctx.rolePermissionConfig = { intersectionOf: { apiKeyRoleId: null } };
+    expect(await service.permissionFlags(ctx)).toEqual([]);
+    ctx.rolePermissionConfig = { shouldBypassPermissionChecks: true };
+    expect(await service.permissionFlags(ctx)).toEqual([]);
+  });
+  it('accepts an alternative admin grant without requiring the operator grant too', async () => {
+    const maps = await cache.getOrRecompute('workspace', []);
+    maps.flatRoleMaps.byUniversalIdentifier[
+      'admin-role'
+    ].rolePermissionFlagIds = ['admin-grant'];
+    const ctx = context('apiKey');
+    ctx.rolePermissionConfig = {
+      intersectionOf: { apiKeyRoleId: 'admin-role' },
+    };
+    expect(
+      await service.allowed(
+        {
+          callerDelegationVersion: 1,
+          requiredAnyPermissionFlagUniversalIdentifiers: [operator, admin],
+        },
+        ctx,
+      ),
+    ).toBe(true);
+    expect(
+      await service.allowed(
+        {
+          callerDelegationVersion: 1,
+          requiredPermissionFlagUniversalIdentifiers: [operator],
+        },
+        ctx,
+      ),
+    ).toBe(false);
+  });
+  it('leaves existing tool definitions unchanged', async () => {
+    expect(await service.allowed({}, context())).toBe(true);
+  });
+});
