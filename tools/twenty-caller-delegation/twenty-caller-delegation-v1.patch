+import { WorkspaceCacheService } from 'src/engine/workspace-cache/services/workspace-cache.service';
+
+@Injectable()
+export class LogicFunctionToolDelegationService {
+  constructor(
+    private readonly workspaceCacheService: WorkspaceCacheService,
+    private readonly applicationTokenService: ApplicationTokenService,
+    private readonly jwtWrapperService: JwtWrapperService,
+  ) {}
+
+  async permissionFlags(context: ToolProviderContext): Promise<string[]> {
+    const config = context.rolePermissionConfig;
+    // A system bypass is not a delegatable human/machine identity.
+    if ('shouldBypassPermissionChecks' in config) return [];
+    const roleIds = getRoleIdsToIntersect(config.intersectionOf);
+    if (!roleIds?.length) return [];
+    const { flatRoleMaps, flatRolePermissionFlagMaps, flatPermissionFlagMaps } =
+      await this.workspaceCacheService.getOrRecompute(context.workspaceId, [
+        'flatRoleMaps',
+        'flatRolePermissionFlagMaps',
+        'flatPermissionFlagMaps',
+      ]);
+    const roles = roleIds.map((flatEntityId) =>
+      findFlatEntityByIdInFlatEntityMaps({
+        flatEntityId,
+        flatEntityMaps: flatRoleMaps,
+      }),
+    );
+    return Object.values(flatPermissionFlagMaps.byUniversalIdentifier)
+      .filter(
+        (flag): flag is NonNullable<typeof flag> =>
+          flag !== undefined && flag !== null,
+      )
+      .filter((flag) =>
+        roles.every((role) => {
+          if (!role) return false;
+          if (flag.permissionType === 'tool' && role.canAccessAllTools)
+            return true;
+          return role.rolePermissionFlagIds.some((id) => {
+            const universalIdentifier =
+              flatRolePermissionFlagMaps.universalIdentifierById[id];
+            return (
+              universalIdentifier !== undefined &&
+              flatRolePermissionFlagMaps.byUniversalIdentifier[
+                universalIdentifier
+              ]?.permissionFlagUniversalIdentifier === flag.universalIdentifier
+            );
+          });
+        }),
+      )
+      .map((flag) => flag!.universalIdentifier);
+  }
+
+  async allowed(
+    settings: ToolTriggerSettings | null | undefined,
+    context: ToolProviderContext,
+  ): Promise<boolean> {
+    const required = settings?.requiredPermissionFlagUniversalIdentifiers ?? [];
+    const anyRequired =
+      settings?.requiredAnyPermissionFlagUniversalIdentifiers ?? [];
+    if (
+      !required.length &&
+      !anyRequired.length &&
+      settings?.callerDelegationVersion !== 1
+    )
+      return true;
+    const flags = await this.permissionFlags(context);
+    return (
+      required.every((flag) => flags.includes(flag)) &&
+      (!anyRequired.length ||
+        anyRequired.some((flag) => flags.includes(flag))) &&
+      this.principalKind(context) !== null
+    );
+  }
+
+  private principalKind(
+    context: ToolProviderContext,
+  ): ToolCaller['kind'] | null {
+    if (
+      context.authContext?.type === 'user' &&
+      context.userId &&
+      context.userWorkspaceId
+    )
+      return 'member';
+    if (context.authContext?.type === 'apiKey') return 'apiKey';
+    if (context.agentId) return 'agent';
+    return null;
+  }
+
+  async delegate(context: ToolProviderContext, targetApplicationId: string) {
+    const kind = this.principalKind(context);
+    if (!kind) throw new Error('Tool caller cannot be delegated');
+    const auth = context.authContext;
+    const workspaceMemberId =
+      auth?.type === 'user' ? auth.workspaceMemberId : null;
+    const id =
+      kind === 'member'
+        ? workspaceMemberId
+        : auth?.type === 'apiKey'
+          ? auth.apiKey.id
+          : context.agentId;
+    if (!id) throw new Error('Tool caller identity is missing');
+    const caller: ToolCaller = {
+      version: 1,
+      workspaceId: context.workspaceId,
+      kind,
+      id,
+      workspaceMemberId,
+      surface: context.agentId ? 'AI_TOOL' : 'MCP',
+      ...(context.agentId ? { agentId: context.agentId } : {}),
+      permissionFlagUniversalIdentifiers: await this.permissionFlags(context),
+    };
+    let accessToken: string;
+    if (auth?.type === 'apiKey') {
+      // Sign the same principal, not a new elevated application principal.
+      // Normal JWT validation rechecks the key's expiry/revocation and role.
+      accessToken = await this.jwtWrapperService.signAsyncOrThrow(
+        {
+          type: JwtTokenTypeEnum.API_KEY,
+          sub: context.workspaceId,
+          workspaceId: context.workspaceId,
+          jti: auth.apiKey.id,
+          ...('workspaceMemberId' in auth &&
+          typeof auth.workspaceMemberId === 'string'
+            ? { workspaceMemberId: auth.workspaceMemberId }
+            : {}),
+        },
+        { expiresIn: '5m' },
+      );
+    } else {
+      let applicationId =
+        auth?.type === 'application'
+          ? auth.application.id
+          : auth?.type === 'user' && auth.application
+            ? auth.application.id
+            : (context.application?.id ?? targetApplicationId);
+      if (kind === 'agent') {
+        const { flatAgentMaps } =
+          await this.workspaceCacheService.getOrRecompute(context.workspaceId, [
+            'flatAgentMaps',
+          ]);
+        const agent = findFlatEntityByIdInFlatEntityMaps({
+          flatEntityId: id,
+          flatEntityMaps: flatAgentMaps,
+        });
+        if (!agent || agent.deletedAt !== null)
+          throw new Error('Tool agent is no longer available');
+        applicationId = agent.applicationId;
+      }
+      const token =
+        await this.applicationTokenService.generateApplicationAccessToken({
+          workspaceId: context.workspaceId,
+          applicationId,
+          ...(kind === 'member'
+            ? {
+                userId: context.userId,
+                userWorkspaceId: context.userWorkspaceId,
+              }
+            : {}),
+          ...(context.agentId ? { agentId: context.agentId } : {}),
+          toolCallerDelegation: true,
+          expiresIn: '5m',
+        });
+      accessToken = token.token;
+    }
+    return { caller, accessToken };
+  }
+}
