+import { type Request } from 'express';
+import { isToolCallerReadRequest } from '../is-tool-caller-read-request.util';
+
+describe('delegated caller API scope', () => {
+  it.each([
+    ['/rest/people', 'GET', undefined, true],
+    ['/rest/people', 'POST', undefined, false],
+    ['/rest/people/id', 'DELETE', undefined, false],
+    ['/rest/metadata/objects', 'POST', undefined, false],
+    ['/metadata', 'POST', '{ me { id } }', false],
+    ['/mcp', 'POST', undefined, false],
+    ['/s/route', 'GET', undefined, false],
+    ['/graphql', 'GET', '{ people { id } }', false],
+    ['/graphql', 'POST', '{ people { id } }', true],
+    ['/graphql', 'POST', 'mutation { deletePerson(id:"id") { id } }', false],
+    ['/graphql', 'POST', 'subscription { people { id } }', false],
+    ['/graphql', 'POST', 'query One { a } query Two { b }', false],
+    ['/graphql', 'POST', 'invalid', false],
+  ])(
+    '%s %s permits only core reads',
+    (originalUrl, method, query, expected) => {
+      expect(
+        isToolCallerReadRequest({
+          originalUrl,
+          method,
+          body: { query },
+        } as Request),
+      ).toBe(expected);
+    },
+  );
+});
diff --git a/packages/twenty-server/src/engine/guards/utils/is-tool-caller-read-request.util.ts b/packages/twenty-server/src/engine/guards/utils/is-tool-caller-read-request.util.ts
