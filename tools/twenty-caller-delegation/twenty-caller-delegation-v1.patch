diff --git a/packages/twenty-server/src/engine/core-modules/tool-provider/services/__tests__/logic-function-tool-delegation.service.spec.ts b/packages/twenty-server/src/engine/core-modules/tool-provider/services/__tests__/logic-function-tool-delegation.service.spec.ts
